{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "diagnosis",
  "description": "One judge diagnosis (protocol/GAPS.md, Diagnosis contract). attempted is explicit; an abstention has attempted false, gap_type null and an abstain_reason starting no_evidence:, contradicted: or thin:.",
  "type": "object",
  "additionalProperties": false,
  "required": ["attempted", "gap_type", "confidence", "need", "claims", "secondary",
               "abstain_reason", "cannot_see"],
  "properties": {
    "attempted": {"type": "boolean"},
    "gap_type": {"type": ["string", "null"], "enum": ["G1", "G2", "G3", "G4", "G5", "G6", null]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "need": {"type": ["string", "null"]},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "artifact_kind", "found", "url", "quote"],
        "properties": {
          "text": {"type": "string", "minLength": 1},
          "artifact_kind": {
            "type": "string",
            "enum": ["homepage", "pricing", "product", "customers", "about", "careers",
                     "contact", "demo_form", "compare", "job_post", "ats_board", "dns"]
          },
          "found": {"type": "boolean"},
          "url": {"type": "string", "minLength": 1},
          "quote": {"type": ["string", "null"]}
        }
      }
    },
    "secondary": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "enum": ["G1", "G2", "G3", "G4", "G5", "G6"]}
    },
    "abstain_reason": {"type": ["string", "null"]},
    "cannot_see": {"type": ["string", "null"]}
  }
}
